#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <34 35 36>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 13>;
        };

        caps {
            bindings = <&kp CLCK>;
            key-positions = <13 14>;
        };

        delete {
            bindings = <&kp DEL>;
            key-positions = <18 31>;
        };

        maintogame {
            bindings = <&to 1>;
            key-positions = <53 54>;
            layers = <0>;
        };

        gametomain {
            bindings = <&to 0>;
            key-positions = <53 54>;
            layers = <1>;
        };

        system {
            bindings = <&mo 5>;
            key-positions = <63 62>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAIN {
            bindings = <
&kp GRAVE         &kp N1        &kp N2  &kp N3        &kp N4        &kp N5         &mmv MOVE_UP     &kp N6           &kp N7    &kp N8        &kp N9    &kp N0     &kp MINUS
&kp TAB           &kp Q         &kp W   &kp E         &kp R         &kp T          &mmv MOVE_DOWN   &kp Y            &kp U     &kp I         &kp O     &kp P      &kp BSLH
&kp LEFT_CONTROL  &kp A         &kp S   &kp D         &kp F         &kp G          &mmv MOVE_LEFT   &kp H            &kp J     &kp K         &kp L     &kp SEMI   &kp APOS
&kp LEFT_SHIFT    &kp Z         &kp X   &kp C         &kp V         &kp B          &mmv MOVE_RIGHT  &kp N            &kp M     &kp COMMA     &kp DOT   &kp FSLH   &kp ENTER
&kp C_MUTE        &kp LEFT_GUI  &none   &kp LEFT_ALT  &lt 4 DELETE  &lt 2 SPACE    &mkp MB1         &lt 3 BACKSPACE  &kp LEFT  &kp UP_ARROW  &kp DOWN  &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "MAIN";
        };

        GAME {
            bindings = <
&kp SEMICOLON     &kp N1  &kp N2  &kp N3        &kp N4  &kp N5       &kp C_VOLUME_UP    &kp N6    &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB           &kp Q   &kp W   &kp E         &kp R   &kp T        &kp C_VOLUME_DOWN  &kp Y     &kp U   &kp I      &kp O    &kp P     &none
&kp LEFT_CONTROL  &kp A   &kp S   &kp D         &kp F   &kp G        &kp C_PREVIOUS     &kp H     &kp J   &kp K      &kp L    &kp SEMI  &none
&kp LEFT_SHIFT    &kp Z   &kp X   &kp C         &kp V   &kp B        &kp C_NEXT         &kp N     &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RET
&kp C_MUTE        &none   &none   &kp LEFT_ALT  &mo 2   &kp SPACE    &kp C_PLAY_PAUSE   &kp BSPC  &trans  &trans     &trans   &trans
            >;

            label = "GAME";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        RAISE {
            bindings = <
&kp TILDE   &kp F1     &kp F2  &kp F3          &kp F4            &kp F5        &mmv MOVE_UP     &kp F6  &kp F7    &kp F8         &kp F9   &kp F10           &none
&none       &kp GRAVE  &none   &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &mmv MOVE_DOWN   &none   &kp HOME  &kp PG_UP      &kp END  &kp MINUS         &kp EQUAL
&none       &kp TILDE  &none   &none           &none             &none         &mmv MOVE_LEFT   &none   &none     &kp PAGE_DOWN  &none    &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LCTRL   &none      &none   &none           &none             &none         &mmv MOVE_RIGHT  &none   &none     &kp INSERT     &kp F11  &kp F12           &none
&kp C_MUTE  &none      &none   &none           &none             &none         &mkp LCLK        &none   &trans    &trans         &trans   &trans
            >;

            display-name = "UP";
            sensor-bindings = <&scroll_encoder>;
            label = "RAISE";
        };

        LOWER {
            bindings = <
&kp TILDE  &kp F1  &kp F2            &kp F3      &kp F4      &kp F5    &mmv MOVE_UP     &kp F6  &kp F7  &kp F8   &kp F9   &kp F10    &none
&none      &none   &kp LS(N7)        &kp LS(N8)  &kp LS(N9)  &none     &mmv MOVE_DOWN   &none   &none   &kp F11  &kp F12  &kp UNDER  &kp PLUS
&none      &none   &kp LS(NUMBER_4)  &kp LS(N5)  &kp LS(N6)  &none     &mmv MOVE_LEFT   &none   &none   &none    &none    &kp LBRC   &kp RBRC
&none      &none   &kp LS(N1)        &kp LS(N2)  &kp LS(N3)  &none     &mmv MOVE_RIGHT  &none   &none   &none    &none    &none      &kp PRINTSCREEN
&none      &none   &kp LS(NUMBER_0)  &none       &none       &none     &mkp LCLK        &none   &trans  &trans   &trans   &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "LOWER";
        };

        SYMBOL {
            bindings = <
&none  &none      &none          &none             &none              &none         &none  &none          &none       &none                 &none                  &none         &none
&none  &kp APOS   &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp PERIOD    &none  &kp AMPERSAND  &kp UNDER   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PERCENT   &none
&none  &kp EXCL   &kp MINUS      &kp PLUS          &kp EQUAL          &kp HASH      &none  &kp PIPE       &kp COLON   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION  &none
&none  &kp CARET  &kp SLASH      &kp ASTERISK      &kp BACKSLASH      &none         &none  &kp TILDE      &kp DOLLAR  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AT_SIGN   &none
&none  &none      &none          &none             &none              &none         &none  &none          &none       &none                 &none                  &none
            >;

            sensor-bindings = <&inc_dec_kp C_NEXT C_PREVIOUS>;
            label = "SYMBOL";
        };

        SYSTEM {
            label = "SYSTEM";
            bindings = <
&kp TILDE        &bt BT_SEL 0                      &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &mmv MOVE_UP     &kp F6       &kp F7          &kp F8      &kp F9     &kp F10    &none
&bt BT_CLR_ALL   &bt BT_CLR                        &none            &none            &none            &none              &mmv MOVE_DOWN   &bootloader  &studio_unlock  &kp F11     &kp F12    &kp UNDER  &kp PLUS
&out OUT_TOG     &none                             &none            &none            &rgb_ug RGB_BRD  &rgb_ug RGB_BRI    &mmv MOVE_LEFT   &none        &none           &none       &none      &kp LBRC   &kp RBRC
&rgb_ug RGB_TOG  &rgb_ug RGB_COLOR_HSB(226,91,42)  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &sys_reset   &bl BL_TOG      &sys_reset  &soft_off  &none      &kp PRINTSCREEN
&none            &none                             &none            &none            &none            &none              &mkp LCLK        &none        &none           &none       &none      &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
